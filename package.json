{
    "name": "plasmex-builder",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4201 --o",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "build:prod": "ng build -c production",
        "clean:compile": "del-cli \"compiler/**\" \"!compiler/.git\" \"!compiler/.gitignore\"",
        "copy:compile": "cpy \"dist/builder/browser/**/*\" compiler --parents",
        "build:compile": "git add . && git commit -m \"cambios\" && git push && npm run build:prod && npm run clean:compile && npm run copy:compile && cd compiler && git add . && git commit -m \"changes\" && git push"
    },
    "prettier": {
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^20.2.14",
        "@angular/common": "^20.1.0",
        "@angular/compiler": "^20.1.0",
        "@angular/core": "^20.1.0",
        "@angular/forms": "^20.1.0",
        "@angular/platform-browser": "^20.1.0",
        "@angular/router": "^20.1.0",
        "bootstrap": "^5.3.8",
        "ngx-image-cropper": "^9.1.6",
        "rxjs": "~7.8.0",
        "swiper": "^12.1.3",
        "tslib": "^2.3.0",
        "video.js": "^8.23.7",
        "xlsx": "^0.18.5",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.1.1",
        "@angular/cli": "^20.1.1",
        "@angular/compiler-cli": "^20.1.0",
        "@types/jasmine": "~5.1.0",
        "@types/video.js": "^7.3.58",
        "cpy-cli": "^7.0.0",
        "del-cli": "^7.0.0",
        "jasmine-core": "~5.8.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~5.8.2"
    }
}
